# SpendWise Environment Configuration Example
# Copy this file to .env in your server directory or root

# Server Environment
PORT=5000
NODE_ENV=development

# Database Mode:
# Set to 'mongodb' to connect to MongoDB Atlas / Local MongoDB
# If left empty, or if MONGODB_URI is not set, server runs in 'demo' in-memory mode
DATA_SOURCE=demo
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/spendwise?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=spendwise_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma separated for multiple)
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
